# Copia in `.env` e compila. Il file `.env` NON va committato (vedi .gitignore).

# --- PostGIS (container kartoza/postgis, vedi docker/postgis/run.sh) ---
PG_HOST=localhost
PG_PORT=65432
PG_USER=giuliano
PG_PASSWORD=changeme
PG_DB=osm

# --- Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) ---
# Registrati su CDSE: sostituisce il vecchio SciHub/SentinelSat (dismesso).
CDSE_USER=
CDSE_PASSWORD=
# Chiavi S3 EODATA (per lettura finestrata COG/JP2 dal bucket CDSE)
# Genera da: CDSE dashboard > S3 credentials
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# --- DB esterni opzionali (usati solo dai vecchi .ipynb in esplorazione) ---
# NUTS4 dal DB LandSupport (se ancora raggiungibile); altrimenti lascia vuoto.
# LANDSUPPORT_URL=postgresql://user:password@host:5432/landsupport   # pragma: allowlist secret
# EXTRA_PG_URL=postgresql://user:password@host:6432/postgres   # pragma: allowlist secret

# --- Percorsi dati locali (opzionali) ---
# DATA_DIR=./data
# OSM_DIR=./osm_data
# ANNOTATIONS_DIR=./annotations
